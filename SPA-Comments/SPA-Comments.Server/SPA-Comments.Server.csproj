<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>SPA_Comments.Server</RootNamespace>
		<UserSecretsId>c0c9dfda-4ea2-4ce4-bdea-ec374c19cc0b</UserSecretsId>
		<DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>

		<!-- ❗ Отключаем SPA в Docker -->
		<ExcludeSpa>true</ExcludeSpa>
		<SkipNpmInstall>true</SkipNpmInstall>

		<!-- Прокси нужен только для локальной отладки -->
		<SpaProxyServerUrl Condition=" '$(Configuration)' == 'Debug' ">https://localhost:50885</SpaProxyServerUrl>
		<SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Fonts\Roboto.ttf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="8.*-*" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="NLog" Version="6.0.5" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.0.5" />
		<PackageReference Include="NLog.Web.AspNetCore" Version="6.0.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Service\Service.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Fonts\Roboto.ttf">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

</Project>
